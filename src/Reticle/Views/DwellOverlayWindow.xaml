<Window x:Class="Reticle.Views.DwellOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Reticle.Controls"
        Title="Reticle progress"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        IsHitTestVisible="False" Focusable="False" Left="-10000" Top="-10000"
        UseLayoutRounding="True">
    <!-- Size is set from code: TargetSize DIPs. -->
    <Grid>
        <c:ProgressRing x:Name="Ring" Fill="{DynamicResource RingBrush}" Outline="{DynamicResource RingOutlineBrush}"
                        OutlineThickness="1.5" />
        <Ellipse x:Name="Dot" Width="6" Height="6" Fill="#FFFFFFFF" Stroke="{DynamicResource RingOutlineBrush}" StrokeThickness="1.5" />
    </Grid>
</Window>
