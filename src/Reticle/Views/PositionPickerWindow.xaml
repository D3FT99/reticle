<Window x:Class="Reticle.Views.PositionPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize" Background="{DynamicResource BackdropBrush}"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual"
        Title="{DynamicResource Picker_WindowTitle}" FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <Style x:Key="ArrowButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Width" Value="96" />
            <Setter Property="Height" Value="96" />
            <Setter Property="Margin" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <EventSetter Event="Click" Handler="OnPositionClicked" />
        </Style>
        <Style x:Key="ArrowIcon" TargetType="Path" BasedOn="{StaticResource IconPath}">
            <Setter Property="Data" Value="{StaticResource IconArrow}" />
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.8" ScaleY="1.8" />
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="StrokeThickness" Value="1.6" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Grid.Column="0" Tag="TopLeft" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource ArrowButton}">
            <Path Style="{StaticResource ArrowIcon}"><Path.RenderTransform><RotateTransform Angle="225" /></Path.RenderTransform></Path>
        </Button>
        <Button Grid.Row="0" Grid.Column="1" Tag="TopCenter" HorizontalAlignment="Center" VerticalAlignment="Top" Style="{StaticResource ArrowButton}">
            <Path Style="{StaticResource ArrowIcon}"><Path.RenderTransform><RotateTransform Angle="270" /></Path.RenderTransform></Path>
        </Button>
        <Button Grid.Row="0" Grid.Column="2" Tag="TopRight" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource ArrowButton}">
            <Path Style="{StaticResource ArrowIcon}"><Path.RenderTransform><RotateTransform Angle="315" /></Path.RenderTransform></Path>
        </Button>
        <Button Grid.Row="1" Grid.Column="0" Tag="MiddleLeft" HorizontalAlignment="Left" Style="{StaticResource ArrowButton}">
            <Path Style="{StaticResource ArrowIcon}"><Path.RenderTransform><RotateTransform Angle="180" /></Path.RenderTransform></Path>
        </Button>

        <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="{DynamicResource Picker_Title}" Style="{StaticResource TitleText}" FontSize="22" HorizontalAlignment="Center" />
            <TextBlock Text="{DynamicResource Picker_Body}"
                       Style="{StaticResource BodyText}" FontSize="13" TextAlignment="Center" Margin="0,6,0,18" MaxWidth="320" />
            <Button Content="{DynamicResource Common_Cancel}" Style="{StaticResource BaseButton}" Width="140" MinHeight="44" HorizontalAlignment="Center"
                    IsCancel="True" Click="OnCancel" />
        </StackPanel>

        <Button Grid.Row="1" Grid.Column="2" Tag="MiddleRight" HorizontalAlignment="Right" Style="{StaticResource ArrowButton}">
            <Path Style="{StaticResource ArrowIcon}" />
        </Button>
        <Button Grid.Row="2" Grid.Column="0" Tag="BottomLeft" HorizontalAlignment="Left" VerticalAlignment="Bottom" Style="{StaticResource ArrowButton}">
            <Path Style="{StaticResource ArrowIcon}"><Path.RenderTransform><RotateTransform Angle="135" /></Path.RenderTransform></Path>
        </Button>
        <Button Grid.Row="2" Grid.Column="1" Tag="BottomCenter" HorizontalAlignment="Center" VerticalAlignment="Bottom" Style="{StaticResource ArrowButton}">
            <Path Style="{StaticResource ArrowIcon}"><Path.RenderTransform><RotateTransform Angle="90" /></Path.RenderTransform></Path>
        </Button>
        <Button Grid.Row="2" Grid.Column="2" Tag="BottomRight" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource ArrowButton}">
            <Path Style="{StaticResource ArrowIcon}"><Path.RenderTransform><RotateTransform Angle="45" /></Path.RenderTransform></Path>
        </Button>
    </Grid>
</Window>
