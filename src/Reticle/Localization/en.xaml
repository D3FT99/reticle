<!-- English (default). Every language file defines the same keys; Localizer swaps the merged dictionary at runtime. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:String x:Key="AppName">Reticle</sys:String>
    <sys:String x:Key="Tip_Rest">Rest (pause clicking)</sys:String>
    <sys:String x:Key="Tip_LeftClick">Left click</sys:String>
    <sys:String x:Key="Tip_RightClick">Right click (select twice to lock)</sys:String>
    <sys:String x:Key="Tip_DoubleClick">Double click (select twice to lock)</sys:String>
    <sys:String x:Key="Tip_Drag">Drag: dwell to pick up, dwell again to drop</sys:String>
    <sys:String x:Key="Tip_Settings">Settings</sys:String>
    <sys:String x:Key="Settings_WindowTitle">Reticle Settings</sys:String>
    <sys:String x:Key="Settings_VersionFormat">Version {0}</sys:String>
    <sys:String x:Key="Common_Cancel">Cancel</sys:String>
    <sys:String x:Key="Common_OK">OK</sys:String>
    <sys:String x:Key="Common_PixelsFormat">{0} px</sys:String>
    <sys:String x:Key="Common_Smaller">Smaller</sys:String>
    <sys:String x:Key="Common_Larger">Larger</sys:String>
    <sys:String x:Key="TargetSize_Title">Target size</sys:String>
    <sys:String x:Key="TargetSize_Body">How far the pointer may drift while dwelling.</sys:String>
    <sys:String x:Key="ToolbarSize_Title">Toolbar size</sys:String>
    <sys:String x:Key="ToolbarSize_Body">Size of each toolbar button.</sys:String>
    <sys:String x:Key="DwellTime_Title">Dwell time</sys:String>
    <sys:String x:Key="DwellTime_Body">How long to rest the pointer before it clicks.</sys:String>
    <sys:String x:Key="DwellTime_Shorter">Shorter</sys:String>
    <sys:String x:Key="DwellTime_Longer">Longer</sys:String>
    <sys:String x:Key="DwellTime_SecondsFormat">{0:0.0} seconds</sys:String>
    <sys:String x:Key="Sound_Title">Click sound</sys:String>
    <sys:String x:Key="Sound_On">Sound is on</sys:String>
    <sys:String x:Key="Sound_Off">Sound is off</sys:String>
    <sys:String x:Key="Position_Title">Toolbar position</sys:String>
    <sys:String x:Key="Position_Change">Change position</sys:String>
    <sys:String x:Key="Position_TopCenter">Top of the screen</sys:String>
    <sys:String x:Key="Position_BottomCenter">Bottom of the screen</sys:String>
    <sys:String x:Key="Position_MiddleLeft">Left edge</sys:String>
    <sys:String x:Key="Position_MiddleRight">Right edge</sys:String>
    <sys:String x:Key="Position_TopLeft">Top left corner</sys:String>
    <sys:String x:Key="Position_TopRight">Top right corner</sys:String>
    <sys:String x:Key="Position_BottomLeft">Bottom left corner</sys:String>
    <sys:String x:Key="Position_BottomRight">Bottom right corner</sys:String>
    <sys:String x:Key="Theme_Title">Theme</sys:String>
    <sys:String x:Key="Theme_Body">Colours of the toolbar, settings and dwell ring.</sys:String>
    <sys:String x:Key="Theme_Midnight">Midnight</sys:String>
    <sys:String x:Key="Theme_Daylight">Daylight</sys:String>
    <sys:String x:Key="Theme_Ocean">Ocean</sys:String>
    <sys:String x:Key="Language_Title">Language</sys:String>
    <sys:String x:Key="Language_Body">Applies immediately.</sys:String>
    <sys:String x:Key="Language_English">English</sys:String>
    <sys:String x:Key="Language_PortuguesePortugal">Português (Portugal)</sys:String>
    <sys:String x:Key="Startup_Title">Start Reticle automatically</sys:String>
    <sys:String x:Key="Startup_Body">Uses Windows Ease of Access. Windows asks for administrator approval the first time.</sys:String>
    <sys:String x:Key="Startup_Desktop">Desktop and User Account Control (UAC) prompts</sys:String>
    <sys:String x:Key="Startup_SignIn">Sign-in screen</sys:String>
    <sys:String x:Key="Settings_Exit">Exit Reticle</sys:String>
    <sys:String x:Key="Settings_Done">Done</sys:String>
    <sys:String x:Key="ExitDialog_Heading">Exit Reticle?</sys:String>
    <sys:String x:Key="ExitDialog_Message">Are you sure that you want to exit? Dwell clicking stops until you start Reticle again.</sys:String>
    <sys:String x:Key="ExitDialog_Yes">Yes, exit</sys:String>
    <sys:String x:Key="ExitDialog_No">No</sys:String>
    <sys:String x:Key="StartupChanged_Heading">Start-up setting changed</sys:String>
    <sys:String x:Key="StartupChanged_Message">This change will take effect next time you start your computer.</sys:String>
    <sys:String x:Key="Picker_WindowTitle">Toolbar position</sys:String>
    <sys:String x:Key="Picker_Title">Move the toolbar</sys:String>
    <sys:String x:Key="Picker_Body">Dwell on an arrow to dock the toolbar at that edge of the screen.</sys:String>
    <sys:String x:Key="Tray_Settings">Settings</sys:String>
    <sys:String x:Key="Tray_Close">Close application</sys:String>
</ResourceDictionary>
