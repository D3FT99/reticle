<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Reticle.Controls">

    <Style TargetType="c:DwellButton">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:DwellButton">
                    <Grid>
                        <Border x:Name="Chrome" CornerRadius="14" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" />
                        <Border x:Name="Hover" CornerRadius="14" Background="{DynamicResource HoverBrush}" Opacity="0" />

                        <!-- Dwell progress: accent fill rising from the bottom. DwellButton clips PART_FillHost to the
                             rounded chrome on every size change, so the fill can never spill past the corners. -->
                        <Grid x:Name="PART_FillHost">
                            <Rectangle Fill="{DynamicResource AccentGradientBrush}" Opacity="0.55" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform ScaleY="{Binding DwellProgress, RelativeSource={RelativeSource TemplatedParent}}" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <!-- Icon occupies the middle 3/5 of the button at any size -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*" />
                                <RowDefinition Height="3*" />
                                <RowDefinition Height="1*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Row="1" Grid.Column="1" Stretch="Uniform">
                                <ContentPresenter />
                            </Viewbox>
                        </Grid>

                        <Border x:Name="LockBadge" Visibility="Collapsed" Width="18" Height="18" CornerRadius="9"
                                Background="{DynamicResource OnAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0">
                            <Viewbox Margin="3">
                                <Path Data="{StaticResource IconLock}" Width="24" Height="24" Stroke="{DynamicResource AccentBrush}"
                                      StrokeThickness="2.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Viewbox>
                        </Border>

                        <Border x:Name="PART_Flash" CornerRadius="14" Background="{DynamicResource FlashBrush}" Opacity="0" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="0.07" />
                        </Trigger>
                        <Trigger Property="ButtonState" Value="Selected">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                        </Trigger>
                        <Trigger Property="ButtonState" Value="Locked">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentGradientBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource OnAccentBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ButtonState" Value="Locked" />
                                <Condition Property="ShowLockBadge" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="LockBadge" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
