<!-- Daylight: light grey surfaces with a blue accent. Every palette defines the same keys; App swaps the merged dictionary at runtime. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AccentColor">#FF1F6FEB</Color>
    <Color x:Key="Accent2Color">#FF0EA5E9</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#241F6FEB" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FF1858C2" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource AccentColor}" />
        <GradientStop Offset="1" Color="{StaticResource Accent2Color}" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="OnAccentBorderBrush" Color="#40FFFFFF" />

    <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F7FFFFFF" />
        <GradientStop Offset="1" Color="#F7EEF1F5" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WindowBrush" Color="#FFF6F7F9" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#26000000" />
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#14000000" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFEDF0F4" />
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#FFD2D8E0" />
    <!-- Overlaid at low opacity for hover and press feedback -->
    <SolidColorBrush x:Key="HoverBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#0A000000" />
    <SolidColorBrush x:Key="FlashBrush" Color="#FF1F6FEB" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#40000000" />
    <SolidColorBrush x:Key="BackdropBrush" Color="#E6F2F4F7" />
    <SolidColorBrush x:Key="TextBrush" Color="#FF1A1D22" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FF5A6472" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFD42A42" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#1FD42A42" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#55D42A42" />

    <!-- Dwell ring: drawn over arbitrary screen content, so it always carries a dark outline -->
    <SolidColorBrush x:Key="RingBrush" Color="#FF1F7BFF" />
    <SolidColorBrush x:Key="RingOutlineBrush" Color="#D9000000" />
    <SolidColorBrush x:Key="DragTrackBrush" Color="#B0A9A9A9" />
</ResourceDictionary>
