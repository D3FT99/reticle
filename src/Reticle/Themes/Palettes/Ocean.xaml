<!-- Ocean: deep sea blue with a teal accent. Every palette defines the same keys; App swaps the merged dictionary at runtime. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AccentColor">#FF14B8A6</Color>
    <Color x:Key="Accent2Color">#FF38BDF8</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#3314B8A6" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FF7EE8DA" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource AccentColor}" />
        <GradientStop Offset="1" Color="{StaticResource Accent2Color}" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="OnAccentBorderBrush" Color="#40FFFFFF" />

    <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F2103044" />
        <GradientStop Offset="1" Color="#F20A1F2D" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WindowBrush" Color="#FF0C202D" />
    <SolidColorBrush x:Key="CardBrush" Color="#FF112837" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF173447" />
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#FF25495F" />
    <!-- Overlaid at low opacity for hover and press feedback -->
    <SolidColorBrush x:Key="HoverBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="FlashBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="BackdropBrush" Color="#D9081620" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFEAF6FA" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FF8FB0BF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFFF7A85" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#26FF7A85" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#55FF7A85" />

    <!-- Dwell ring: drawn over arbitrary screen content, so it always carries a dark outline -->
    <SolidColorBrush x:Key="RingBrush" Color="#FF22D3C0" />
    <SolidColorBrush x:Key="RingOutlineBrush" Color="#D9000000" />
    <SolidColorBrush x:Key="DragTrackBrush" Color="#B0A9A9A9" />
</ResourceDictionary>
