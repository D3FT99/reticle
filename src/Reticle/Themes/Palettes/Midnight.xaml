<!-- Midnight: neutral graphite with an azure accent. Every palette defines the same keys; App swaps the merged dictionary at runtime. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AccentColor">#FF3D8BFF</Color>
    <Color x:Key="Accent2Color">#FF2BB3FF</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#333D8BFF" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FF9CC4FF" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource AccentColor}" />
        <GradientStop Offset="1" Color="{StaticResource Accent2Color}" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="OnAccentBorderBrush" Color="#40FFFFFF" />

    <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F21E2025" />
        <GradientStop Offset="1" Color="#F2131417" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WindowBrush" Color="#FF16181C" />
    <SolidColorBrush x:Key="CardBrush" Color="#FF1D2025" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF272A31" />
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#FF3A3E47" />
    <!-- Overlaid at low opacity for hover and press feedback -->
    <SolidColorBrush x:Key="HoverBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="FlashBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="BackdropBrush" Color="#D90E0F12" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFF2F4F7" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FF9AA1AC" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFFF6B7A" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#26FF6B7A" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#55FF6B7A" />

    <!-- Dwell ring: drawn over arbitrary screen content, so it always carries a dark outline -->
    <SolidColorBrush x:Key="RingBrush" Color="#FF4D9BFF" />
    <SolidColorBrush x:Key="RingOutlineBrush" Color="#D9000000" />
    <SolidColorBrush x:Key="DragTrackBrush" Color="#B0A9A9A9" />
</ResourceDictionary>
