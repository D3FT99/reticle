<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the notification-area icon (NotifyIcon); no WinForms global usings, to keep WPF names unambiguous. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WFO0003 asks WinForms apps to set DPI in code; this is a WPF app whose DPI awareness belongs in app.manifest. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Reticle</RootNamespace>
    <AssemblyName>Reticle</AssemblyName>
    <Product>Reticle</Product>
    <AssemblyTitle>Reticle</AssemblyTitle>
    <Version>1.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(Configuration)' == 'Release'">app.release.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Reticle.ico</ApplicationIcon>
    <StartupObject>Reticle.Program</StartupObject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Reticle.ico" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Reticle.Tests" />
  </ItemGroup>

</Project>
